# CodeOracle - Environment Variables Configuration

# ── Backend Configuration ──────────────────────────────────────────────────
# Runtime mode: development | production | test
ENV=production

# Server port (automatically assigned by Render, Railway, Cloud Run, or Docker)
PORT=8000

# Google Gemini API Key (Required for AI explanations, test generation, and modernization refactoring)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated list or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Optional custom temporary directory for uploaded workspaces
# CODEORACLE_TEMP_DIR=/tmp/codeoracle/jobs

# ── Frontend Configuration ─────────────────────────────────────────────────
# Public URL of the backend API (leave empty when deploying unified container)
# Example for split deployment: https://codeoracle-backend.onrender.com
VITE_API_BASE_URL=

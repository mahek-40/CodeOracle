# CodeOracle Backend - Environment Variables

ENV=production
PORT=8000

# Google Gemini API Key (Required for AI explanations, test generation, and refactoring)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed CORS origins or *
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Optional custom temp workspace directory
# CODEORACLE_TEMP_DIR=/tmp/codeoracle/jobs
